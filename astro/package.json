{
  "name": "dd-docs-astro",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "dev:proxied": "PROXIED=1 astro dev --port 4321",
    "build": "astro build",
    "build:en": "SKIP_TRANSLATIONS=true astro build",
    "preview": "astro preview --port 4322",
    "preview:proxied": "PROXIED=1 astro preview --port 4321",
    "test": "yarn test:headless && yarn test:browser",
    "test:headless": "vitest run",
    "test:browser": "USE_DEV_SERVER=true playwright test",
    "test-ai": "yarn test:headless-ai && yarn test:browser-ai",
    "test:headless-ai": "vitest run --reporter=dot --silent=true",
    "test:browser-ai": "USE_DEV_SERVER=true playwright test --reporter=dot",
    "kill-dev": "lsof -ti :4321 | xargs kill -9 2>/dev/null || true"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdoc": "^2.0.6",
    "@astrojs/preact": "^6.0.2",
    "astro": "^7.1.5",
    "cdocs-data": "https://s3.amazonaws.com/origin-static-assets/corp-node-packages/master/cdocs-data-v2.0.0.tgz",
    "marked": "^18.0.7",
    "preact": "^10.29.7",
    "shiki": "^4.3.1",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@playwright/test": "^1.62.0",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "happy-dom": "^20.11.1",
    "openapi-types": "^12.1.3",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "typesense": "^3.0.6",
    "vitest": "^4.1.10"
  }
}
