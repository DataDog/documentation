---
import '../styles/global.css';
import AnnouncementBanner from '@components/AnnouncementBanner/AnnouncementBanner.astro';
import Header from '@components/Header/Header.astro';
import Footer from '@components/Footer/Footer.astro';
import { resolveLocale, type Locale } from '@lib/i18n/locale';
import { getBannerParams, type BannerParams } from '@lib/componentUtils/bannerData';
import { DevBadge } from '@components/DevBadge/DevBadge';
import Telemetry from '@components/Telemetry/Telemetry.astro';
import { resolveSiteEnv } from '@lib/site/siteEnv';
import { getAllowedRegions, DEFAULT_REGION_KEY } from '@config/regions';
import {
  TWITTER_HANDLE,
  THEME_COLOR,
  DEFAULT_OG_IMAGE,
  getLocaleDefaults,
} from '@lib/seo';
import { ClientRouter } from 'astro:transitions';
import faviconUrl from '../assets/favicon.ico?url';
import nationalWebLightWoff2 from '../assets/fonts/NationalWeb-Light.woff2?url';
import nationalWebSemiboldWoff2 from '../assets/fonts/NationalWeb-Semibold.woff2?url';
import robotoMonoRegularWoff from '../assets/fonts/RobotoMono-Regular.woff?url';

interface Props {
  title: string;
  description?: string;
  /** Full URL or absolute path. Defaults to `Astro.site + Astro.url.pathname`. */
  canonical?: string;
  /** Absolute URL of the social-share image. */
  image?: string;
  /** OpenGraph type; defaults to "article" to match Hugo. */
  ogType?: 'website' | 'article';
  /** Per-locale URLs for `<link rel="alternate" hreflang>`. */
  hreflang?: Array<{ hreflang: string; href: string }>;
  /** Per-page banner override, mirroring Hugo's page-level `announcement_banner`. */
  announcementBanner?: BannerParams;
  /**
   * Opt into Astro view transitions (adds <ClientRouter />). Used by cdocs so
   * changing a filter swaps the freshly SSR-rendered content in smoothly
   * instead of a full-page blink. Off by default so other routes are unaffected.
   */
  enableViewTransitions?: boolean;
}

const {
  title,
  description: descriptionProp,
  canonical: canonicalProp,
  image: imageProp,
  ogType = 'article',
  hreflang,
  announcementBanner,
  enableViewTransitions = false,
} = Astro.props;

// Resolve the banner the same way the component does, so the body's
// `announcement` class (which drives the header/body offset) stays in lockstep
// with whether a banner actually renders. Mirrors Hugo's `hasAnnouncementBanner`.
const bannerParams = announcementBanner ?? getBannerParams();
const hasBanner = Object.keys(bannerParams).length > 0;

const lang: Locale = resolveLocale(Astro.currentLocale);
const localeDefaults = getLocaleDefaults(lang);
const description = descriptionProp ?? localeDefaults.metaDescription;
const siteName = localeDefaults.siteName;
const image = imageProp ?? DEFAULT_OG_IMAGE;
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = canonicalProp ?? `${siteOrigin}${Astro.url.pathname}`;
const ogUrl = canonical;
// `data-env` on <html>, for debugging and env-conditional styling. Telemetry
// itself does not read it (it resolves the environment at build time), but the
// planned shared Ask AI package expects the attribute to be present.
const env = resolveSiteEnv();

// Resolve any relative hreflang hrefs against the site origin.
const hreflangResolved = hreflang?.map((h) => ({
  hreflang: h.hreflang,
  href: h.href.startsWith('http') ? h.href : `${siteOrigin}${h.href}`,
}));

// Region visibility is data-driven: the allow-list handed to the inline script
// and the CSS at the end of this file both come from `shared/regions.yaml`.
// Adding a data center there is the only edit needed.
const allowedRegions = getAllowedRegions();
const regionKeysJson = JSON.stringify(allowedRegions.map((r) => r.key));

// One selector pair per region. CSS cannot compare `html[data-active-region]`
// against an element's own `data-region` value, so the pairs are generated
// instead of hand-written.
//
// This has to be static CSS rather than a script that stamps matching
// elements: a script in `<head>` runs before the body is parsed and would
// find no elements, and one at the end of `<body>` would leave every region
// element hidden until it ran.
const activeRegionSelectors = allowedRegions
  .map((r) => `html[data-active-region='${r.key}'] [data-region='${r.key}']`)
  .join(',\n');
---

<html lang={lang} data-env={env}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="canonical" href={canonical} />
    {enableViewTransitions && <ClientRouter />}

    {/* Schema.org */}
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="article:author" content="Datadog" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {hreflangResolved?.map((h) => (
      <link rel="alternate" hreflang={h.hreflang} href={h.href} />
    ))}

    <link rel="preload" href={nationalWebLightWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nationalWebSemiboldWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={robotoMonoRegularWoff} as="font" type="font/woff" crossorigin />
    <script is:inline define:vars={{ regionKeysJson, defaultRegion: DEFAULT_REGION_KEY }}>
      (function () {
        // Resolve the active Datadog region before first paint so region-scoped
        // content (elements with `data-region`) renders in its final state and
        // there's no flash of the wrong region. Precedence matches Hugo:
        // ?site= query param → `site` cookie → default `us`. Referrer-based
        // sync runs later in the regionState module.
        var allowed = JSON.parse(regionKeysJson);
        var params = new URLSearchParams(window.location.search);
        var fromQuery = params.get('site');
        var cookieMatch = document.cookie.match(/(?:^|; )site=([^;]*)/);
        var fromCookie = cookieMatch ? decodeURIComponent(cookieMatch[1]) : null;
        var region = defaultRegion;
        if (fromQuery && allowed.indexOf(fromQuery) !== -1) {
          region = fromQuery;
        } else if (fromCookie && allowed.indexOf(fromCookie) !== -1) {
          region = fromCookie;
        }
        document.documentElement.setAttribute('data-active-region', region);
      })();
    </script>
    {/* Per-region visibility rules, generated from `shared/regions.yaml`.
        The hidden-by-default rule lives in global.css. */}
    <style set:html={`${activeRegionSelectors} { display: revert; }`}></style>
    {/* Datadog RUM + Browser Logs. Its bundled script is deferred, so placing
        it here costs nothing against first paint. */}
    <Telemetry />
  </head>
  <body class:list={[{ announcement: hasBanner }]}>
    <AnnouncementBanner override={announcementBanner} />
    <Header />
    <div class="base-layout__body">
      <slot />
    </div>
    <Footer />
    {import.meta.env.MODE === 'development' && <DevBadge client:idle />}
    <style>
      .base-layout__body {
        padding-top: calc(var(--hugo-active-banner-height) + var(--hugo-header-height));
      }

      @media (min-width: 992px) {
        .base-layout__body {
          padding-top: calc(var(--hugo-active-banner-height) + var(--hugo-header-height-desktop));
        }
      }
    </style>
  </body>
</html>
