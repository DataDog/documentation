---
export const prerender = true;
import { getCollection, getEntry, render } from 'astro:content';
import ApiLayout from '@layouts/ApiLayout.astro';
import ApiPageHeader from '@components/ApiPageHeader/ApiPageHeader.astro';
import { getCategoryStubsView } from '@lib/api/viewsBuilder';
import { API_CONTENT_DIR, isApiContentId, getOverviewPagesView } from '@lib/api/overviewPages';
import { LOCALES, parseLangParam, localizedHref } from '@lib/i18n/locale';
import { i18n } from '@lib/i18n/i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('en', (entry) => isApiContentId(entry.id));
  const paths: ReturnType<GetStaticPaths> = [];
  for (const lang of LOCALES) {
    for (const entry of entries) {
      paths.push({
        params: {
          lang: lang === 'en' ? undefined : lang,
          page: entry.id === API_CONTENT_DIR ? undefined : entry.id.slice(`${API_CONTENT_DIR}/`.length),
        },
      });
    }
  }
  return paths;
};

// getStaticPaths only emits valid params, so these are build-time invariants:
// if they ever fail, the params contract is broken and the build should too.
const lang = parseLangParam(Astro.params.lang);
if (!lang) throw new Error(`Unexpected lang param: ${Astro.params.lang}`);

const pageSlug = Astro.params.page;
const isRootPage = !pageSlug;

const entryId = isRootPage ? API_CONTENT_DIR : `${API_CONTENT_DIR}/${pageSlug}`;
const entry = await getEntry('en', entryId);
if (!entry) throw new Error(`Missing API content entry: ${entryId}`);

const categories = await getCategoryStubsView(lang);
const overviewPages = await getOverviewPagesView();
const { Content } = await render(entry);

const pageTitle = isRootPage ? 'Datadog API Reference' : `${entry.data.title} - Datadog API`;

const breadcrumbs =
  isRootPage
    ? [
        { label: i18n('docs', lang), href: localizedHref(lang, '/') },
        { label: i18n('api', lang) },
      ]
    : [
        { label: i18n('docs', lang), href: localizedHref(lang, '/') },
        { label: i18n('api', lang), href: localizedHref(lang, '/api/latest/') },
        { label: entry.data.title },
      ];
---

<ApiLayout
  title={pageTitle}
  description={entry.data.description}
  lang={lang}
  categories={categories}
  overviewPages={overviewPages}
  isOverviewSection={true}
  activeOverviewPageSlug={isRootPage ? undefined : pageSlug}
  breadcrumbs={breadcrumbs}
>
  <ApiPageHeader title={entry.data.title} lang={lang} />
  <Content />
</ApiLayout>
