---
// Catch-all on-demand route for every `en` collection entry. Whether or not a
// doc is filterable, it renders here on the server. Filterable docs (those with
// `content_filters`) additionally resolve their filters per request (URL param
// > default) so non-matching content is dropped by vanilla Markdoc before the
// HTML is sent; non-filterable docs simply render their content. Nothing but
// the URL affects the render, so the same URL always gets the same HTML.
//
// This is the lowest-priority route, so more specific ones (`/`,
// `/[...lang]/api/...`) still win; only otherwise-unmatched paths reach here.
// A path with no matching `en` entry falls through to a 404.
export const prerender = false;

import { getEntry, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteSupportBanner from "@components/SiteSupportBanner/SiteSupportBanner.astro";
import CdocsFilterBar from "@components/CdocsFilterBar/CdocsFilterBar";
import CopyPageButtonIsland from "@components/CopyPageButton/CopyPageButtonIsland.astro";
import { resolvePageFilterValues } from "@lib/cdocs/filters";
import { isApiContent } from "@lib/api/overviewPages";
import { getCdocsTraitsListUrl } from "@lib/cdocs/pageLists";
import { buildPageFiltersManifest } from "@lib/cdocs/pageFiltersManifest";
import {
  pruneManifestForClient,
  type ClientSideFiltersManifest,
} from "cdocs-data";
import {
  CDOCS_PAGE_STATE_ID,
  serializeCdocsPageState,
} from "@lib/cdocs/pageState";
import { pathPrefix, prefixed } from "@lib/site/pathPrefix";

// `[...slug]` yields the full path with no leading/trailing slash, which is
// exactly an `en` entry id (path under content/en, without the extension).
const slug = Astro.params.slug ?? "";

// dd_e2e/* are test pages; hidden in the live build like every other dd_e2e
// route (which each carry their own `__CI_ENV__ === 'live'` guard).
if (slug.startsWith("dd_e2e/") && __CI_ENV__ === "live") {
  return new Response(null, { status: 404 });
}

// API content renders only through the API routes, which normally win anyway.
// A build that skips the API docs has no API routes, so it 404s instead.
if (isApiContent(slug)) {
  return new Response(null, { status: 404 });
}

const entry = await getEntry("en", slug);
// Any other en entry renders here; a path with no entry 404s.
if (!entry) {
  return new Response(null, { status: 404 });
}

const contentFilters = entry.data.content_filters;
const isFilterable = contentFilters !== undefined;

// Filterable docs resolve their filters, and the filter bar gets a pruned
// manifest, so it can build each option's URL from the reader's picks; plain
// docs render with no filter state.
let valsByTraitId: Record<string, string> = {};
let clientFiltersManifest: ClientSideFiltersManifest | undefined;
if (isFilterable) {
  const filtersManifest = buildPageFiltersManifest(contentFilters);
  valsByTraitId = resolvePageFilterValues({
    contentFilters,
    filtersManifest,
    searchParams: Astro.url.searchParams,
  });
  clientFiltersManifest = pruneManifestForClient(filtersManifest);
}

// Read by `preferencesClient`, which stores the URL's filter values and adds
// stored preferences to Cdocs links. Every product doc gets it, since any page
// can link to a Cdocs page.
const cdocsPageState = serializeCdocsPageState({
  valsByTraitId,
  traitsListUrl: prefixed(await getCdocsTraitsListUrl()),
  pathPrefix: pathPrefix(),
});

// The resolved values become Markdoc variables ($prog_lang, ...), which the
// built-in `if` tags evaluate to drop non-matching content at render time.
const { Content } = await render(entry);

// Crawler metadata: a canonical URL that pins the resolved filter values, so
// each filtered variant has a stable, indexable address.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
for (const [traitId, value] of Object.entries(valsByTraitId)) {
  canonicalUrl.searchParams.set(traitId, value);
}

// Plaintext (`.md`) twin of this page, preserving the current filter query so
// the plaintext reflects the same resolved state. Trailing slash is stripped so
// the path matches an `en` entry id. Testing aid for now.
const plaintextHref = `${Astro.url.pathname.replace(/\/$/, "")}.md${Astro.url.search}`;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonicalUrl.href}
  metaImage={entry.data.meta_image}
  contentPath={`${entry.id}.md`}
  enableViewTransitions
>
  <div class="cdoc-layout">
    <main class="cdoc">
      <SiteSupportBanner
        pathname={Astro.url.pathname}
        siteSupportId={entry.data.site_support_id}
      />
      <h1 transition:name="cdoc-title">{entry.data.title}</h1>
      <script
        is:inline
        type="application/json"
        id={CDOCS_PAGE_STATE_ID}
        set:html={cdocsPageState}
      />
      {
        isFilterable && clientFiltersManifest && (
          <CdocsFilterBar
            client:load
            bareUrl={prefixed(`/${slug}/`)}
            filtersManifest={clientFiltersManifest}
            contentFilters={contentFilters}
            valsByTraitId={valsByTraitId}
          />
        )
      }
      <div class="cdoc__content prose" transition:name="cdoc-content">
        <Content {...valsByTraitId} />
      </div>
    </main>
    <nav class="cdoc-rightnav">
      <CopyPageButtonIsland />
      {
        /* TODO: temporary testing link to the plaintext (.md) version. Only
          filterable docs currently have a working `.md` twin. */
      }
      {
        isFilterable && (
          <a class="cdoc-rightnav__plaintext-link" href={plaintextHref}>
            View as plaintext
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<script>
  import { startCdocsPreferences } from "@lib/cdocs/preferencesClient";

  startCdocsPreferences();
</script>

<style>
  .cdoc-layout {
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
  }

  .cdoc {
    flex: 1;
    min-width: 0;
    padding: var(--space-lg);
  }

  .cdoc :global(h2) {
    margin-top: var(--space-xl);
  }

  .cdoc-rightnav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: 80px var(--space-md) var(--space-lg);
    width: 180px;
    flex-shrink: 0;
  }

  .cdoc-rightnav__plaintext-link {
    font-size: var(--font-size-sm);
  }
</style>
