---
export const prerender = true;
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  // api/latest/* entries have their own dedicated route
  // (src/pages/[...lang]/api/latest/[...page].astro), which renders them with
  // ApiLayout instead of BaseLayout. Exclude them here so the two routes
  // don't both claim the same URL.
  const docs = await getCollection('en', (entry) => !entry.id.startsWith('api/latest'));
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props as { entry: CollectionEntry<'en'> };

if (__CI_ENV__ === 'live' && entry.id.startsWith('dd_e2e/')) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(entry);

// Only the Markdoc component pages ship a `.md` plaintext twin (see
// dd_e2e/components/[component].md.ts).
const isMarkdocComponentPage = entry.id.startsWith('dd_e2e/components/');
const plaintextHref = `/${entry.id}.md`;
---

<BaseLayout title={entry.data.title}>
  <div class="docs-page">
    <nav><a href="/dd_e2e/">&larr; Test Pages</a></nav>
    {isMarkdocComponentPage && (
      <p class="plaintext-link">
        <a href={plaintextHref}>View this page as plaintext</a>
      </p>
    )}
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-lg);
  }

  h1 {
    border-bottom: var(--border-width-thick) solid var(--color-border-strong);
    padding-bottom: var(--space-sm);
  }

  h2 {
    margin-top: var(--space-xl);
  }

  .plaintext-link {
    margin: var(--space-sm) 0 0;
  }
</style>
