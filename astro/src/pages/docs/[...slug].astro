---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props as { entry: CollectionEntry<'docs'> };

if (__CI_ENV__ === 'live' && entry.id.startsWith('test_pages/')) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(entry);

// Only the Markdoc component pages ship a `.md` plaintext twin (see
// test_pages/components/[component].md.ts).
const isMarkdocComponentPage = entry.id.startsWith('test_pages/components/');
const plaintextHref = `/docs/${entry.id}.md`;
---

<BaseLayout title={entry.data.title}>
  <div class="docs-page">
    <nav><a href="/docs/test_pages/">&larr; Test Pages</a></nav>
    {isMarkdocComponentPage && (
      <p class="plaintext-link">
        <a href={plaintextHref}>View this page as plaintext</a>
      </p>
    )}
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-lg);
  }

  h1 {
    border-bottom: var(--border-width-thick) solid var(--color-border-strong);
    padding-bottom: var(--space-sm);
  }

  h2 {
    margin-top: var(--space-xl);
  }

  .plaintext-link {
    margin: var(--space-sm) 0 0;
  }
</style>
