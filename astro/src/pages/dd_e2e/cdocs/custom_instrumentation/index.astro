---
// On-demand rendered cdoc TEST PAGE — a proof-of-concept fixture, not real
// product content. It lives under /dd_e2e/ (mirroring Hugo's e2e fixtures) so
// it can't collide with a real docs URL. Filters resolve per request (URL
// param > cookie > default); irrelevant content is dropped server-side by
// vanilla Markdoc before the HTML is sent.
export const prerender = false;

import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import CdocsFilterBar from '@components/CdocsFilterBar/CdocsFilterBar';
import { resolvePageFilters } from '@lib/cdocs/filters';
import { COOKIE_NAME, readPrefs, writePrefs } from '@lib/cdocs/cookiePrefs';

const CDOC_ID = 'dd_e2e/cdocs/custom_instrumentation';

const entry = await getEntry('docs', CDOC_ID);
if (!entry) return new Response(null, { status: 404 });

const contentFilters = entry.data.content_filters ?? [];

// Collect the filter values expressed in the URL query string.
const urlVals: Record<string, string> = {};
for (const filter of contentFilters) {
  const value = Astro.url.searchParams.get(filter.trait_id);
  if (value) urlVals[filter.trait_id] = value;
}

// Read persisted preferences from the cookie.
const cookieRaw = Astro.cookies.get(COOKIE_NAME)?.value;
const cookieVals = readPrefs(cookieRaw);

// Resolve (via cdocs-data): URL param > cookie > default.
const { resolvedFilters, valsByTraitId } = resolvePageFilters({
  contentFilters,
  urlVals,
  cookieVals,
});

// Persist the resolved values back to the cookie (trait-keyed, oldest evicted
// past the cap) so a selection survives navigation to other cdocs.
Astro.cookies.set(COOKIE_NAME, writePrefs(cookieRaw, valsByTraitId, Date.now()), {
  path: '/',
  sameSite: 'lax',
  maxAge: 60 * 60 * 24 * 365,
});

// The resolved values become Markdoc variables ($prog_lang, $api_type), which
// the built-in `if` tags evaluate to drop non-matching content at render time.
const { Content } = await render(entry);

// Crawler metadata: a canonical URL that pins the resolved filter values, so
// each filtered variant has a stable, indexable address.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
for (const [traitId, value] of Object.entries(valsByTraitId)) {
  canonicalUrl.searchParams.set(traitId, value);
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonicalUrl.href}
  enableViewTransitions
>
  <main class="cdoc">
    <h1 transition:name="cdoc-title">{entry.data.title}</h1>
    <CdocsFilterBar client:load filters={resolvedFilters} />
    <div class="cdoc__content" transition:name="cdoc-content">
      <Content {...valsByTraitId} />
    </div>
  </main>
</BaseLayout>

<style>
  .cdoc {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-lg);
  }

  .cdoc :global(h2) {
    margin-top: var(--space-xl);
  }
</style>
