---
if (__CI_ENV__ === "live") return new Response(null, { status: 404 });

import BaseLayout from "@layouts/BaseLayout.astro";

const title = "Footer";
---

<BaseLayout title={title}>
  <div class="docs-page">
    <nav><a href="/dd_e2e/">&larr; Test Pages</a></nav>
    <div class="prose">
      <h1>Footer</h1>

      <p>
        Site-wide footer rendered at the bottom of every page by <code
          >BaseLayout</code
        >. Ported from the docs-default branch of Hugo's <code>footer.html</code
        > partial — dimensions, colors, and interactions match the Hugo site. Scroll
        to the bottom of this page to see the footer itself.
      </p>

      <h2>Sub-components</h2>
      <table>
        <thead>
          <tr><th>Component</th><th>Type</th><th>Role</th></tr>
        </thead>
        <tbody>
          <tr
            ><td><code>Footer.astro</code></td><td>Astro (static)</td><td
              >Footer shell — reads menu data at build time and renders the docs
              blurb, logo / mobile-app row, and bottom row statically.</td
            ></tr
          >
          <tr
            ><td><code>FooterBlurb.astro</code></td><td>Static</td><td
              >Docs-only "Can't find something?" intro with the Contact Us CTA.</td
            ></tr
          >
          <tr
            ><td><code>FooterNav.astro</code></td><td>Astro (static)</td><td
              >The whole link nav: the nested Product column (category →
              subcategory → products, each category with an inline icon) plus
              the Resources / Blog / About lists. Static because it is 100+
              links — too much to pass as island props.</td
            ></tr
          >
          <tr
            ><td><code>FooterAccordionController.tsx</code></td><td
              >Preact island</td
            ><td
              >Renders nothing; attaches the mobile accordion to <code
                >FooterNav</code
              > through its <code>data-footer-*</code> hooks. Below 768px one section
              and one product category stay open at a time (none open initially);
              at or above 768px every panel is open and the headers are disabled.
              Panel visibility and header open state are tracked separately: above
              the breakpoint panels show but no header is marked open, since the
              open state is what tints a heading with the accent color.</td
            ></tr
          >
          <tr
            ><td><code>LanguageSelector.tsx</code></td><td>Preact island</td><td
              >Bottom-row globe/caret dropdown. Shows the current language plus
              alternates. English-only for now; add to <code
                >availableLanguages</code
              > in <code>Footer.astro</code> when more languages land.</td
            ></tr
          >
          <tr
            ><td><code>SocialIcon.astro</code></td><td>Static</td><td
              >Inlines a social-network SVG from <code
                >mocked-dependencies/websites_modules/static/icons/</code
              >, keyed by the <code>pre</code> field in <code
                >footer_social</code
              >. Replaces Hugo's icon font.</td
            ></tr
          >
          <tr
            ><td><code>SvgIcon.astro</code></td><td>Static (shared)</td><td
              >Shared icon component at <code>src/components/SvgIcon/</code> (used
              here and elsewhere, e.g. the Stepper). Inlines an SVG by filename from
              <code>src/assets/images/svg-icons/</code> or <code
                >src/assets/images/icons/</code
              >, performing Hugo's <code>default-*</code> placeholder substitutions
              for size/color/opacity.</td
            ></tr
          >
        </tbody>
      </table>

      <h2>Data flow</h2>
      <p>
        Footer data is assembled at build time by <code
          >getFooterData(lang)</code
        > in <code>src/lib/componentUtils/footerMenus.ts</code>, which reads <code
          >config/_default/menus/menus.en.yaml</code
        > from <code>@websites-modules</code>, sorts by <code>weight</code>,
        translates section headings with <code>useTranslations(lang)</code>, and
        resolves URLs with <code>resolveFooterUrl()</code>. The menu YAML itself
        is English-only; <code>lang</code> selects the translations, not the source
        file. The Product column comes from <code
          >getFooterProductCategories(lang)</code
        > in <code>menuData.ts</code>, which keeps upstream's nesting: one entry
        per category that has children, each carrying its label, inline icon,
        subcategory groups, and the <code>footer_layout</code> column-flow hints.
        The component receives a single view model with named slots (<code
          >product</code
        >, <code>linkSections</code>, <code>sub</code>, <code>social</code>).
        The language selector reads from
        <code>src/lib/i18n/languageNames.ts</code>.
      </p>

      <h2>Properties (Language selector)</h2>
      <table>
        <thead>
          <tr
            ><th>Property</th><th>Type</th><th>Default</th><th>Description</th
            ></tr
          >
        </thead>
        <tbody>
          <tr
            ><td><code>currentLang</code></td><td
              ><code>LanguageOption</code></td
            ><td>(required)</td><td
              >Current language — <code
                >&#123; code, primary, secondary, href &#125;</code
              ></td
            ></tr
          >
          <tr
            ><td><code>alternates</code></td><td
              ><code>LanguageOption[]</code></td
            ><td><code>[]</code></td><td
              >Alternate languages; popup reveals these</td
            ></tr
          >
          <tr
            ><td><code>worldIconHtml</code></td><td><code>string</code></td><td
              >(required)</td
            ><td>Pre-inlined globe SVG</td></tr
          >
          <tr
            ><td><code>caretIconHtml</code></td><td><code>string</code></td><td
              >(required)</td
            ><td>Pre-inlined caret SVG</td></tr
          >
        </tbody>
      </table>

      <h2>Dimensions (Hugo-identical)</h2>
      <table>
        <thead>
          <tr><th>Viewport</th><th>Footer padding-bottom</th><th>Layout</th></tr
          >
        </thead>
        <tbody>
          <tr
            ><td>&lt;768px</td><td>30px</td><td
              >Single-column stack; every accordion section and category closed</td
            ></tr
          >
          <tr
            ><td>≥768px</td><td>36px</td><td
              >Accordion off — all panels open, headers disabled. Product
              categories flow into three columns; Resources / Blog / About sit
              in a three-column grid.</td
            ></tr
          >
          <tr
            ><td>≥1200px</td><td>16px</td><td
              >Product takes 8 of 12 columns with its categories in four;
              Resources / Blog / About fold into two columns beside it.</td
            ></tr
          >
        </tbody>
      </table>

      <h2>Tokens</h2>
      <p>
        See the Hugo-identical section of <code>src/styles/tokens.css</code> (the
        <code>--hugo-footer-*</code> and <code>--hugo-lang-toggle-*</code> blocks).
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-lg);
  }

  h1 {
    border-bottom: var(--border-width-thick) solid var(--color-border-strong);
    padding-bottom: var(--space-sm);
  }

  h2 {
    margin-top: var(--space-xl);
  }
</style>
