---
import CodeBlock from "@components/CodeBlock/CodeBlock.astro";
import ExpandChevron from "@components/ExpandChevron/ExpandChevron.astro";
import styles from "./ApiRequestBodyTabs.module.css";
import { classListFactory } from "@lib/cssUtils/classListFactory";

const cl = classListFactory(styles);

interface Example {
  name: string;
  value: string;
}

interface Props {
  examples: Example[];
  showTitles: boolean;
  /** Shared by the entries, so only one is open at a time, as in Hugo. */
  accordionName: string;
}

const { examples, showTitles, accordionName } = Astro.props;
---

<div class={cl("request-body-tabs__examples")}>
  {
    showTitles
      ? examples.map((ex, i) => (
          <details
            class={cl("request-body-tabs__accordion")}
            name={accordionName}
            open={i === 0}
          >
            <summary class={cl("request-body-tabs__accordion-header")}>
              <ExpandChevron class={cl("request-body-tabs__accordion-icon")} />
              <span>{ex.name}</span>
            </summary>
            <CodeBlock content={ex.value} language="json" />
          </details>
        ))
      : examples.map((ex) => <CodeBlock content={ex.value} language="json" />)
  }
</div>
