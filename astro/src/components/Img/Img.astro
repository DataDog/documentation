---
import ImgController from "./ImgController";
import ImgVideo from "./ImgVideo";
import { IMAGES_URL } from "@config/images";
import type { ImgTagProps } from "./imgTypes";

type Props = ImgTagProps;

const {
  src,
  alt,
  caption,
  width,
  height,
  widthPercent,
  video = false,
  inline = false,
  popup = true,
} = Astro.props;

const imageUrl = `${IMAGES_URL}/images/${src}`;

const srcset = `${imageUrl}?auto=format&fit=max&w=850 1x, ${imageUrl}?auto=format&fit=max&w=850&dpr=2 2x`;
const popupHref = `${imageUrl}?fit=max&auto=format`;

const imgControllerProps = {
  alt,
  caption,
  width,
  height,
  widthPercent,
  inline,
  popup,
  srcset,
  popupHref,
  imageUrl,
};

const needsLightbox = !inline && popup;
---

{
  video ? (
    <ImgVideo
      imageUrl={imageUrl}
      width={width}
      height={height}
      widthPercent={widthPercent}
    />
  ) : needsLightbox ? (
    <ImgController client:idle {...imgControllerProps} />
  ) : (
    <ImgController {...imgControllerProps} />
  )
}
