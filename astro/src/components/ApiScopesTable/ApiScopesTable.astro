---
// The authorization scopes tables on `/api/latest/scopes/`, one per group of
// overlapping tags. Replaces Hugo's `api-scopes` shortcode; the grouping is
// built in `scopesBuilder.ts`.
//
// Endpoint pages link to `/api/latest/scopes/#<tag anchor>`. Each anchor is an
// empty span placed before its heading, so a jump lands with the heading in
// view (Hugo places them after it).
import styles from "./ApiScopesTable.module.css";
import { classListFactory } from "@lib/cssUtils/classListFactory";
import { localizedHref, resolveLocale } from "@lib/i18n/locale";
import { getScopeGroupsView, type ScopeGroup } from "@lib/api/scopesBuilder";

interface Props {
  /** Defaults to the groups built from the spec. Passed only by tests. */
  groups?: ScopeGroup[];
}

const { groups = getScopeGroupsView() } = Astro.props;
const lang = resolveLocale(Astro.currentLocale);
const cl = classListFactory(styles);
---

<div class={cl("api-scopes-table")}>
  {
    groups.map((group) => (
      <section class={cl("api-scopes-table__group")}>
        {group.anchors.map((anchor) => (
          <span id={anchor} class={cl("api-scopes-table__anchor")} />
        ))}
        <h3 class={cl("api-scopes-table__heading")}>{group.heading}</h3>
        <table class={cl("api-scopes-table__table")}>
          <thead>
            <tr>
              {/* TODO: localize the column headers once Hugo has i18n keys for them. */}
              <th class={cl("api-scopes-table__column--name")}>Scope name</th>
              <th class={cl("api-scopes-table__column--description")}>
                Description
              </th>
              <th class={cl("api-scopes-table__column--endpoints")}>
                Endpoints that require this scope
              </th>
            </tr>
          </thead>
          <tbody>
            {group.scopes.map((scope) => (
              <tr class={cl("api-scopes-table__row")}>
                <td>
                  <code class={cl("api-scopes-table__scope-name")}>
                    {scope.name}
                  </code>
                </td>
                <td class={cl("api-scopes-table__description")}>
                  {scope.description}
                </td>
                <td>
                  <ul class={cl("api-scopes-table__endpoints")} role="list">
                    {scope.endpoints.map((endpoint) => (
                      <li class={cl("api-scopes-table__endpoint")}>
                        <a href={localizedHref(lang, endpoint.href)}>
                          {endpoint.summary}
                        </a>
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }
</div>
