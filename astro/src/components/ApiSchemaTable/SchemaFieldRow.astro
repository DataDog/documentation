---
import type { SchemaField } from "@lib/api/schemas/schemaField";
import { renderMarkdown } from "@lib/api/markdownRenderer";
import { classListFactory } from "@lib/cssUtils/classListFactory";
import ExpandChevron from "@components/ExpandChevron/ExpandChevron.astro";
import styles from "./ApiSchemaTable.module.css";
import Self from "./SchemaFieldRow.astro";

const cl = classListFactory(styles);

const ENUM_INLINE_LIMIT = 10;
// Indent 20px per level, stopping at 7 levels so deep rows (dashboard
// widgets nest 10+ levels) keep enough of the name column to stay readable.
const INDENT_PX = 20;
const MAX_INDENT_DEPTH = 7;

interface Props {
  field: SchemaField;
  depth: number;
}

const { field, depth } = Astro.props;

const hasChildren =
  (field.children !== undefined && field.children.length > 0) ||
  (field.unionOptions !== undefined && field.unionOptions.length > 0);

// The CSS uses this for both the name's padding and the toggle's position.
const indentDepth = Math.min(depth, MAX_INDENT_DEPTH);
const cellNameStyle =
  depth > 0 ? `--schema-table-indent: ${indentDepth * INDENT_PX}px` : undefined;

const enumValues = field.enumValues ?? [];
const enumVisible = enumValues.slice(0, ENUM_INLINE_LIMIT);
const enumRest = enumValues.slice(ENUM_INLINE_LIMIT);

// Block-level, so multi-paragraph spec descriptions keep their breaks. The
// DEPRECATED label goes inside the first paragraph.
const deprecatedLabelHtml = `<strong class="${cl("schema-table__deprecated-label")}">DEPRECATED</strong>`;
const descriptionHtml = renderMarkdown(field.description ?? "");
const descriptionWithLabelHtml = !field.deprecated
  ? descriptionHtml
  : descriptionHtml.startsWith("<p>")
    ? descriptionHtml.replace("<p>", `<p>${deprecatedLabelHtml} `)
    : `<p>${deprecatedLabelHtml}</p>${descriptionHtml}`;

// `oneOf`/`anyOf` are carried as bare semantic tags on the field so other
// consumers can branch on them; the type column shows them bracketed.
// Array items are already bracketed upstream
// (`[<oneOf>]`), so only the bare tags need wrapping here. The plaintext
// twin applies the same mapping in its own `getFieldType`.
const displayType =
  field.type === "oneOf" || field.type === "anyOf"
    ? `<${field.type}>`
    : field.type;

// Render each oneOf/anyOf option as its own collapsible row,
// rather than a flat always-visible banner. Each option becomes a synthetic
// object field whose children are the option's fields, so it reuses the same
// toggle + hidden-children construction the nav island already drives.
const optionFields: SchemaField[] =
  field.unionOptions?.map((option) => ({
    name: option.label,
    // The branch's own type, so a scalar variant reads `double` rather than
    // `object`. Scalar variants carry no nested rows.
    type: option.type,
    required: false,
    deprecated: option.deprecated === true,
    readOnly: false,
    description: option.description ?? "",
    ...(option.enumValues ? { enumValues: option.enumValues } : {}),
    ...(option.defaultValue !== undefined
      ? { defaultValue: option.defaultValue }
      : {}),
    ...(option.fields.length > 0 ? { children: option.fields } : {}),
  })) ?? [];
---

<div
  class:list={[
    cl("schema-table__row"),
    field.readOnly && cl("schema-table__row--readonly"),
    field.deprecated && cl("schema-table__row--deprecated"),
  ]}
  data-field-name={field.name}
  data-depth={depth}
>
  <div class={cl("schema-table__cell-name")} style={cellNameStyle}>
    {
      hasChildren && (
        <button
          type="button"
          class={cl("schema-table__toggle")}
          aria-expanded="false"
          aria-label={`Toggle ${field.name}`}
        >
          <ExpandChevron />
        </button>
      )
    }
    <span class={cl("schema-table__name-group")}>
      <code class={cl("schema-table__name")}>{field.name}</code>
      {
        /* MISSING_TRANSLATION_LABEL: translate "[required]", "DEPRECATED", "Default:", "Allowed enum
          values:", "Show N more", and "Toggle <field>" once authoritative
          translation keys exist in the Hugo i18n bundle. */
      }
      {
        field.required && (
          <span class={cl("schema-table__required")}> [required]</span>
        )
      }
    </span>
  </div>
  <div class={cl("schema-table__cell-type")}>
    <span class={cl("schema-table__type")}>{displayType}</span>
  </div>
  <div class={cl("schema-table__cell-description")}>
    <div
      class={cl("schema-table__description")}
      set:html={descriptionWithLabelHtml}
    />
    {
      field.defaultValue !== undefined && (
        <span class={cl("schema-table__default")}>
          {" "}
          Default: <code>{field.defaultValue}</code>
        </span>
      )
    }
    {
      enumValues.length > 0 && (
        <div class={cl("schema-table__enum")}>
          Allowed enum values: <code>{enumVisible.join(", ")}</code>
          {enumRest.length > 0 && (
            <details class={cl("schema-table__enum-details")}>
              <summary>Show {enumRest.length} more</summary>
              <code>{enumRest.join(", ")}</code>
            </details>
          )}
        </div>
      )
    }
  </div>
</div>
{
  hasChildren && (
    <div class={cl("schema-table__children")} hidden>
      {field.children?.map((child) => (
        <Self field={child} depth={depth + 1} />
      ))}
      {optionFields.map((optionField) => (
        <Self field={optionField} depth={depth + 1} />
      ))}
    </div>
  )
}
