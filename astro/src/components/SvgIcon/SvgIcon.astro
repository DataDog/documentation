---
/**
 * Inlines an SVG asset by filename, mirroring Hugo's svg.html partial. Sources
 * from both `images/svg-icons/` and `images/icons/` (matching Hugo's two icon
 * folders), keyed by bare filename. Replaces `default-size` / `default-fill` /
 * `default-opacity` placeholders with the props passed in, matching the
 * behavior Hugo uses to color world.svg etc. at render time.
 */
const iconModules = import.meta.glob<string>(
  ['../../assets/images/svg-icons/*.svg', '../../assets/images/icons/*.svg'],
  { query: '?raw', import: 'default', eager: true }
);

const iconsByFilename: Record<string, string> = {};
for (const [path, raw] of Object.entries(iconModules)) {
  const filename = path.split('/').pop();
  if (filename) iconsByFilename[filename] = raw;
}

interface Props {
  src: string;
  size?: string;
  color?: string;
  opacity?: string;
  class?: string;
}

const { src, size = '100%', color = '#000000', opacity = '1.0', class: className } = Astro.props;
const rawOriginal: string | undefined = iconsByFilename[src];

const raw = rawOriginal
  ? rawOriginal
      .replaceAll('default-size', size)
      .replaceAll('default-fill', color)
      .replaceAll('default-opacity', opacity)
  : undefined;
---

{raw ? (
  <span class={`svg-icon ${className ?? ''}`} set:html={raw} />
) : (
  <span class={`svg-icon svg-icon--missing ${className ?? ''}`} aria-hidden="true" />
)}

<style is:global>
  .svg-icon {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }
  .svg-icon--missing {
    width: 1em;
    height: 1em;
    background: currentColor;
    opacity: 0.4;
    border-radius: 50%;
  }
</style>
