---
import ApiMethodBadge from "@components/ApiMethodBadge/ApiMethodBadge.astro";
import Alert from "@components/Alert/Alert.astro";
import ApiSchemaTable from "@components/ApiSchemaTable/ApiSchemaTable.astro";
import ApiEndpointVersionContent from "./ApiEndpointVersionContent.astro";
import ApiVersionSelect from "./ApiVersionSelect";
import type { SchemaField } from "@lib/api/schemas/schemaField";
import type { ResponseData } from "@components/ApiResponse/ApiResponse.astro";
import type { CodeExampleSet } from "@components/ApiCodeExample/ApiCodeExample.astro";
import { getDefaultRegions } from "@lib/api/regionResolver";
import { renderMarkdownInline } from "@lib/api/markdownRenderer";
import styles from "./ApiEndpoint.module.css";
import { classListFactory } from "@lib/cssUtils/classListFactory";
import { useTranslations } from "@lib/i18n/i18n";
import { localizedHref, resolveLocale } from "@lib/i18n/locale";

const allRegions = getDefaultRegions();
const cl = classListFactory(styles);

interface EndpointData {
  operationId: string;
  summary: string;
  slug: string;
  method: string;
  path: string;
  description: string;
  version: "v1" | "v2";
  deprecated: boolean;
  unstable: boolean;
  unstableMessage?: string;
  permissions?: string[];
  permissionsMatch?: "any" | "all";
  oauthScopes?: string[];
  oauthScopesMatch?: "any";
  oauthScopesAnchor?: string;
  regionUrls?: Record<string, string>;
  pathParams?: SchemaField[];
  queryParams?: SchemaField[];
  headerParams?: SchemaField[];
  requestBody?: {
    required: boolean;
    description?: string;
    schema: SchemaField[];
    examples: Array<{ name: string; value: string }>;
    showExampleTitles?: boolean;
  };
  responses: ResponseData[];
  codeExamples: CodeExampleSet[];
  dateVersions?: Array<{
    apiVersion: string;
    requestBody?: EndpointData["requestBody"];
    responses: ResponseData[];
    codeExamples: CodeExampleSet[];
  }>;
}

interface Props {
  data: string; // JSON string of EndpointData
  /** The operation page can place this control in its version pill instead. */
  showDateVersionSelect?: boolean;
}

const { data: dataJson, showDateVersionSelect = true } = Astro.props;
const translate = useTranslations(Astro.currentLocale);

let ep: EndpointData | null = null;
try {
  ep = JSON.parse(dataJson);
} catch {
  // invalid JSON
}

const oauthScopesHref =
  ep?.oauthScopesAnchor &&
  localizedHref(
    resolveLocale(Astro.currentLocale),
    `/api/latest/scopes/#${ep.oauthScopesAnchor}`,
  );

const hasParams =
  ep &&
  ((ep.pathParams && ep.pathParams.length > 0) ||
    (ep.queryParams && ep.queryParams.length > 0) ||
    (ep.headerParams && ep.headerParams.length > 0));

// Hugo shows the Overview heading on every operation, even with nothing
// under it. Show it only when a description, permissions, or scopes follow.
const hasOverview =
  ep &&
  (Boolean(ep.description) ||
    (ep.permissions && ep.permissions.length > 0) ||
    (ep.oauthScopes && ep.oauthScopes.length > 0));
const versionContents = ep
  ? [
      {
        apiVersion: "base",
        requestBody: ep.requestBody,
        responses: ep.responses,
        codeExamples: ep.codeExamples,
      },
      ...(ep.dateVersions ?? []),
    ]
  : [];
---

{
  ep && (
    <section class={cl("api-endpoint")} data-operation-id={ep.operationId}>
      {/* No id: the operation page's `{slug}-{version}` tab panel is the
        anchor, and a bare-slug id here would repeat once per version. */}
      {/* Status alerts */}
      {/* MISSING_TRANSLATION_LABEL: translate the unstable/region-not-supported messages,
        permissions label, and the "Body Data" label and "(required)" marker
        once authoritative translation keys exist in the Hugo i18n bundle. */}
      {ep.unstable && (
        <Alert level="warning">
          <Fragment
            set:html={renderMarkdownInline(
              ep.unstableMessage ??
                "This endpoint is unstable and may change without notice.",
            )}
          />
        </Alert>
      )}

      <div class={cl("api-endpoint__url-line")}>
        <ApiMethodBadge method={ep.method} />
        {allRegions.map((region) => {
          const url = ep.regionUrls?.[region.key];
          return url ? (
            <code class={cl("api-endpoint__path")} data-region={region.key}>
              {url}
            </code>
          ) : (
            <code
              class={cl(
                "api-endpoint__path",
                "api-endpoint__path--unsupported",
              )}
              data-region={region.key}
            >
              Not supported in the {region.label} region
            </code>
          );
        })}
      </div>
      {showDateVersionSelect &&
        ep.dateVersions &&
        ep.dateVersions.length > 0 && (
          <ApiVersionSelect
            client:load
            majorVersion={ep.version}
            dates={ep.dateVersions
              .map((version) => version.apiVersion)
              .toReversed()}
            operationId={ep.operationId}
          />
        )}

      {/* Description — rendered as slot content from the parent page */}
      {hasOverview && (
        <h3 class={cl("api-endpoint__overview-heading")}>
          {translate("overview")}
        </h3>
      )}
      <slot />

      {/* Permissions */}
      {ep.permissions && ep.permissions.length === 1 && (
        <div class={cl("api-endpoint__permissions")}>
          <p>
            This endpoint requires the <code>{ep.permissions[0]}</code>{" "}
            permission.
          </p>
        </div>
      )}
      {ep.permissions && ep.permissions.length > 1 && (
        <div class={cl("api-endpoint__permissions")}>
          <p>
            This endpoint requires {ep.permissionsMatch ?? "all"} of the
            following permissions:
          </p>
          <ul>
            {ep.permissions.map((permission) => (
              <li>
                <code>{permission}</code>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* OAuth scopes */}
      {ep.oauthScopes && ep.oauthScopes.length > 0 && (
        <div class={cl("api-endpoint__oauth-scopes")}>
          {ep.oauthScopesMatch === "any" ? (
            <p>
              OAuth apps require one of the following authorization{" "}
              {ep.oauthScopesAnchor ? (
                <a href={oauthScopesHref}>scopes</a>
              ) : (
                "scopes"
              )}{" "}
              to access this endpoint:{" "}
              {ep.oauthScopes.map((scope, index) => (
                <>
                  {index > 0 && ", "}
                  <code>{scope}</code>
                </>
              ))}
              .
            </p>
          ) : (
            <p>
              OAuth apps require the <code>{ep.oauthScopes.join(", ")}</code>{" "}
              authorization{" "}
              {ep.oauthScopesAnchor ? (
                <a href={oauthScopesHref}>scope</a>
              ) : (
                "scope"
              )}{" "}
              to access this endpoint.
            </p>
          )}
        </div>
      )}

      {/* Arguments */}
      {hasParams && (
        <div class={cl("api-endpoint__section")} data-api-section="arguments">
          <h3>{translate("arguments")}</h3>
          {ep.pathParams && ep.pathParams.length > 0 && (
            <ApiSchemaTable
              fields={ep.pathParams}
              title={translate("path_parameters")}
            />
          )}
          {ep.queryParams && ep.queryParams.length > 0 && (
            <ApiSchemaTable
              fields={ep.queryParams}
              title={translate("query_strings")}
            />
          )}
          {ep.headerParams && ep.headerParams.length > 0 && (
            <ApiSchemaTable
              fields={ep.headerParams}
              title={translate("header_parameters")}
            />
          )}
        </div>
      )}

      {ep.dateVersions && ep.dateVersions.length > 0 ? (
        versionContents.map((content) => (
          <div
            class={cl("api-endpoint__version-content")}
            data-api-version-content={content.apiVersion}
            hidden={content.apiVersion !== "base"}
          >
            <ApiEndpointVersionContent
              requestBody={content.requestBody}
              responses={content.responses}
              codeExamples={content.codeExamples}
            />
          </div>
        ))
      ) : (
        <ApiEndpointVersionContent
          requestBody={ep.requestBody}
          responses={ep.responses}
          codeExamples={ep.codeExamples}
        />
      )}
    </section>
  )
}
