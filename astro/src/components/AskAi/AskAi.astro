---
// The Ask AI widget: the floating button and the conversational panel, both
// owned by the `@dd/ask-ai` package. Rendered once by BaseLayout, so
// every route gets it.
//
// A bundled `<script>` rather than `is:inline`, since it needs the npm import.
// Astro emits it as a deferred module, so the widget mounts after first paint.
//
// Bundled scripts do not re-execute on view-transition soft navigation, so the
// mount-once shape below needs no guard. `mountAskAi` is idempotent anyway,
// because the searchbar's Ask AI row calls it too.
---

<script>
  import { createAskAiConfig } from "@lib/askAi/askAiConfig";

  /**
   * Dynamic, so that the deferred mount covers all three of the fetch, the parse
   * and the mount. A static import would leave the first two in the page's load
   * — the module graph is evaluated before this script's own body runs — and
   * defer only the panel construction, which is the smallest of the three.
   */
  const mountWidget = async () => {
    const { mountAskAi } = await import("@dd/ask-ai");

    // TODO: no flag resolver is passed here, so `docs-ai-enabled` does not govern
    // Astro — the package falls back to its `true` default. Flipping the flag off
    // disables Ask AI on Hugo only. Supply a resolver once Astro has a feature-flag
    // client, or if the kill switch is ever needed on Astro before then.
    mountAskAi(createAskAiConfig());
  };

  const mountAtIdle = () => {
    if ("requestIdleCallback" in window) {
      requestIdleCallback(() => void mountWidget(), { timeout: 3000 });
    } else {
      setTimeout(() => void mountWidget(), 200);
    }
  };

  // Waiting for `load`, then idle, keeps the package off the critical path.
  // Idle alone is not enough: the first idle period usually comes before `load`,
  // and a large high-priority script fetched then lands in the page's own load,
  // where Lighthouse counts it toward critical path latency. The widget is a
  // floating button, so arriving late costs nothing — it is `position: fixed`
  // and cannot shift the page.
  //
  // The impression event still reports once per document load, so this does not
  // change what telemetry sees. Timer fallback for Safari, which shipped
  // `requestIdleCallback` only in 17.4; `timeout` so a page that never idles
  // still mounts.
  if (document.readyState === "complete") {
    mountAtIdle();
  } else {
    window.addEventListener("load", mountAtIdle, { once: true });
  }
</script>
