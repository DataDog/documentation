  "email_support_sentence": {
    "other": "<a href=\"http://help.datadoghq.com\" target=\"_blank\" rel=\"noopener\">Datadog サポート Web サイト</a>にアクセスして、サポートチームにお問い合わせください。(すべてのサイト)<br><br> サポート Web サイトへのログイン方法の詳細については、<a href=\"https://docs.datadoghq.com/account_management/faq/access-your-support-ticket\" target=\"_blank\">「サポートチケットへのアクセス」</a>を参照してください。"
  },
  "live_chat_support_sentence": {
    "other": "Datadog サポートチームと、月曜日から金曜日の 10:00 から 19:00 (東部標準時間) まで、アプリ内チャットでチャットできます。ベストプラクティスについては、<a href=\"https://docs.datadoghq.com/getting_started/support/#reaching-out-on-chat\" target=\"_blank\" rel=\"noopener\">「チャットでのお問い合わせ」</a>を参照してください。"
  },
  "event_stream_support_sentence": {
    "other": "<a href=\"http://chat.datadoghq.com/\" target=\"_blank\" rel=\"noopener\">Slack Community プログラム</a>は、Datadog ユーザーが Datadog ユーザーのために構築したネットワークで、互いに質問への回答を見つけたり、製品のヒントやコツを共有したりすることができます。"
  },
  "foundation_enablement_sentence": {
    "other": "<a href=\"https://dtdg.co/fe_sessions\" target=\"_blank\" rel=\"noopener\">お申し込み</a>いただくと、Datadog のさまざまな機能や製品について、専門家が指導する基礎知識習得のためのライブセッションに参加できます。"
  },
  "learning_center_sentence": {
    "other": "セルフガイド形式の <a href=\"https://dtdg.co/47QnE99\" target=\"_blank\" rel=\"noopener\">ハンズオンコース</a>で、Datadog の主要なコンセプトを学び、実践できます。"
