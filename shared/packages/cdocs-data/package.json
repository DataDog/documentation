{
  "name": "cdocs-data",
  "version": "2.0.1",
  "description": "Utilities for working with customizable docs data",
  "packageManager": "yarn@4.10.3",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ClientSideFiltersManifest": {
      "import": "./dist/schemas/pageFilters.js",
      "types": "./dist/schemas/pageFilters.d.ts"
    },
    "./getTraitValsFromUrl": {
      "import": "./dist/api/browser/getTraitValsFromUrl.js",
      "types": "./dist/api/browser/getTraitValsFromUrl.d.ts"
    },
    "./writeTraitValsToUrl": {
      "import": "./dist/api/browser/writeTraitValsToUrl.js",
      "types": "./dist/api/browser/writeTraitValsToUrl.d.ts"
    },
    "./CdocsClientStorage": {
      "import": "./dist/api/browser/CdocsClientStorage.js",
      "types": "./dist/api/browser/CdocsClientStorage.d.ts"
    },
    "./resolveFilters": {
      "import": "./dist/api/shared/resolveFilters.js",
      "types": "./dist/api/shared/resolveFilters.d.ts"
    },
    "./semverIsAtLeast": {
      "import": "./dist/api/shared/semverIsAtLeast.js",
      "types": "./dist/api/shared/semverIsAtLeast.d.ts"
    },
    "./convertTraitValueToSemver": {
      "import": "./dist/api/shared/convertTraitValueToSemver.js",
      "types": "./dist/api/shared/convertTraitValueToSemver.d.ts"
    },
    "./validateOptionGroupId": {
      "import": "./dist/api/shared/validateOptionGroupId.js",
      "types": "./dist/api/shared/validateOptionGroupId.d.ts"
    }
  },
  "scripts": {
    "prepack": "yarn build",
    "test": "yarn build; vitest run --coverage --reporter=verbose",
    "test:watch": "yarn build; vitest",
    "build": "rimraf ./dist && npx tsc",
    "build-docs": "npx typedoc --readme none --exclude *.ts",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">= 20.11.0"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 90,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "@types/semver": "^7.7.1",
    "js-yaml": "^4.3.2",
    "jsdom": "^26.1.0",
    "rimraf": "^5.0.5",
    "semver": "^7.7.4",
    "typedoc": "^0.27.9",
    "typedoc-plugin-markdown": "^4.4.2",
    "typedoc-plugin-zod": "^1.3.1",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.58",
    "@vitest/coverage-v8": "^2.1.9",
    "depcheck": "^1.4.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
