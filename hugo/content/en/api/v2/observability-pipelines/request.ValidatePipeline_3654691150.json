{
  "data": {
    "attributes": {
      "config": {
        "destinations": [
          {
            "id": "datadog-logs-destination",
            "inputs": [
              "my-processor-group"
            ],
            "type": "datadog_logs"
          }
        ],
        "processor_groups": [
          {
            "enabled": true,
            "id": "my-processor-group",
            "include": "service:my-service",
            "inputs": [
              "datadog-agent-source"
            ],
            "processors": [
              {
                "enabled": true,
                "id": "spike-protection-processor",
                "include": "*",
                "type": "spike_protection",
                "name": "MyPartitionedSpikeProtection",
                "spike_action": "no_action",
                "partition_fields": [
                  "service"
                ],
                "action_when_missing_partitions": "default_bucket",
                "minimal_threshold_overrides": [
                  {
                    "fields": [
                      {
                        "name": "service",
                        "value": "checkout"
                      }
                    ],
                    "minimal_threshold": {
                      "type": "threshold",
                      "bytes": 53687091200
                    }
                  },
                  {
                    "fields": [
                      {
                        "name": "service",
                        "value": "payments"
                      }
                    ],
                    "minimal_threshold": {
                      "type": "always_keep"
                    }
                  }
                ]
              }
            ]
          }
        ],
        "sources": [
          {
            "id": "datadog-agent-source",
            "type": "datadog_agent"
          }
        ]
      },
      "name": "Pipeline with Spike Protection Threshold Overrides"
    },
    "type": "pipelines"
  }
}